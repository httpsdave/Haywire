---
import { getDateLabels } from '../utils/data';

interface Props {
  activeDate?: string;
}

const { activeDate } = Astro.props;
const dateLabels = getDateLabels();
const visibleLabels = dateLabels.slice(0, 2);
const hiddenLabels = dateLabels.slice(2);
---

<div class="date-selector">
  {visibleLabels.map(({ label, slug, isToday }) => (
    <a
      href={isToday ? '/' : `/archive/${slug}/`}
      class:list={[{ active: activeDate ? slug === activeDate : isToday }]}
    >
      {label}
    </a>
  ))}
  {hiddenLabels.length > 0 && (
    <button type="button" onclick="this.nextElementSibling.style.display='inline'; this.style.display='none';">...</button>
  )}
  <span style="display: none;">
    {hiddenLabels.map(({ label, slug, isToday }) => (
      <a
        href={isToday ? '/' : `/archive/${slug}/`}
        class:list={[{ active: activeDate ? slug === activeDate : isToday }]}
      >
        {label}
      </a>
    ))}
  </span>
</div>
