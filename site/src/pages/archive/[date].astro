---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Navigation from '../../components/Navigation.astro';
import AboutPanel from '../../components/AboutPanel.astro';
import DonatePanel from '../../components/DonatePanel.astro';
import DateSelector from '../../components/DateSelector.astro';
import NewsSection from '../../components/NewsSection.astro';
import Footer from '../../components/Footer.astro';

import {
  allCategories,
  getDateLabels,
} from '../../utils/data';

// Generate static paths for the last 7 days
export function getStaticPaths() {
  const paths = [];
  for (let i = 1; i <= 7; i++) {
    const d = new Date(Date.now() - i * 86400000);
    const slug = d.toISOString().split('T')[0];
    paths.push({ params: { date: slug } });
  }
  return paths;
}

const { date } = Astro.params;

// In production, we'd load data from JSON files for this date
// For now, use mock data (same as today)
const categories = allCategories;

const dateObj = new Date(date + 'T00:00:00');
const months = ['January','February','March','April','May','June','July','August','September','October','November','December'];
const displayDate = `${months[dateObj.getMonth()]} ${dateObj.getDate()}, ${dateObj.getFullYear()}`;
---

<BaseLayout title={`Haywire — Archive: ${displayDate}`} description={`News archive for ${displayDate} on Haywire.`}>
  <Header />
  <Navigation currentPage="front-page" />
  <AboutPanel />
  <DonatePanel />

  <main class="container">
    <DateSelector activeDate={date} />

    <div class="archive-banner">
      <p>📰 Archive: <strong>{displayDate}</strong></p>
    </div>

    {categories.map((cat, i) => (
      <>
        <NewsSection category={cat} />
        {i < categories.length - 1 && <hr class="section-divider" />}
      </>
    ))}
  </main>

  <Footer />
</BaseLayout>

<style>
  .archive-banner {
    text-align: center;
    padding: 0.75rem;
    margin-bottom: 1rem;
    background: #f5f5f0;
    border: 1px solid #ddd;
    font-family: var(--font-ui);
    font-size: 0.85rem;
    color: #555;
    border-radius: 3px;
  }

  .archive-banner strong {
    color: #000;
  }
</style>
